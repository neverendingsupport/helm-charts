{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update digest-pinned ACK helper image references.',
      managerFilePatterns: [
        '/^charts/ack-.+/values\\.ya?ml$/',
      ],
      matchStrings: [
        '\\S+:\\s+\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\\s+# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)',
      ],
    },
  ],
  postUpgradeTasks: {
    commands: [
      'python scripts/regenerate_golden_files.py',
    ],
    fileFilters: [
      'tests/fixtures/**/*.golden.yaml',
    ],
    executionMode: 'branch',
  },
  automerge: true,
  automergeType: 'pr',
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
  ],
}
